<odoo>
    <record id="medicine_usage_view_list" model="ir.ui.view">
        <field name="name">medicine.usage.view.list</field>
        <field name="model">medicine.usage</field>
        <field name="arch" type="xml">
            <list string="List Title">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="medicine_usage_view_form" model="ir.ui.view">
        <field name="name">medicine.usage.view.form</field>
        <field name="model">medicine.usage</field>
        <field name="arch" type="xml">
            <form string="Form Title">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label for="name" string="For"/>
                            <field name="name"/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="medicine_usage_action" model="ir.actions.act_window">
        <field name="name">Medicine Usage</field>
        <field name="res_model">medicine.usage</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="medicine_usage_menuitem" name="Medicine Usage" parent="stock.menu_stock_inventory_control" action="medicine_usage_action" sequence="39"/>
</odoo>