<odoo>
    <record id="pharmacy_active_ingredient_view_view_list" model="ir.ui.view">
        <field name="name">pharmacy.active.ingredient.view.list</field>
        <field name="model">active.ingredient</field>
        <field name="arch" type="xml">
            <list string="List Title">
                <field name="name"/>
                <field name="usage"/>
            </list>
        </field>
    </record>
    <record id="pharmacy_active_ingredient_view_view_form" model="ir.ui.view">
        <field name="name">pharmacy.active.ingredient.view.view.form</field>
        <field name="model">active.ingredient</field>
        <field name="arch" type="xml">
            <form string="Form Title">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Active Ingredient..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="usage"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="pharmacy_active_ingredient_view_action" model="ir.actions.act_window">
        <field name="name">Pharmacy Active Ingredient View</field>
        <field name="res_model">active.ingredient</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="pharmacy_active_ingredient_view" name="Active Ingredient" parent="stock.menu_stock_inventory_control" action="pharmacy_active_ingredient_view_action" sequence="6"/>
</odoo>